{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cv-trust/evidence-manifest-v1.schema.json",
  "title": "CV-Trust sanitized evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "redaction_version", "model_identifier", "command", "implementation_tree_sha256", "fixtures", "artifacts", "live_artifacts", "live_status"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "redaction_version": {"const": "bounded-evidence-v1"},
    "model_identifier": {"type": "string", "minLength": 1, "maxLength": 128},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 256}},
    "implementation_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fixtures": {"type": "array", "items": {"$ref": "#/$defs/fixture"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "live_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "live_status": {"enum": ["unexecuted", "executed"]}
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "kind"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "kind": {"type": "string", "pattern": "^[a-z0-9_]+$"}
      }
    }
  }
}
